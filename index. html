                const q = searchQuery.toLowerCase().trim();
                const matchSearch = !q || 
                    item.title.toLowerCase().includes(q) || 
                    item.summary.toLowerCase().includes(q) ||
                    item.tools.some(t => t.toLowerCase().includes(q)) ||
                    item.syllabus.some(s => s.toLowerCase().includes(q));
                return matchGrade && matchCat && matchSearch;
            });

            materiGrid.innerHTML = "";

            if (filtered.length === 0) {
                materiGrid.classList.add("hidden");
                emptyState.classList.remove("hidden");
                return;
            }

            materiGrid.classList.remove("hidden");
            emptyState.classList.add("hidden");

            filtered.forEach(item => {
                const gradeBadgeColor = item.grade === "X" 
                    ? "bg-emerald-500/15 text-emerald-400 border-emerald-500/30" 
                    : item.grade === "XI" 
                        ? "bg-tech-500/15 text-tech-400 border-tech-500/30" 
                        : "bg-indigo-500/15 text-indigo-400 border-indigo-500/30";

                const card = document.createElement("div");
                card.className = "group rounded-3xl bg-navy-900/90 border border-slate-800 p-6 flex flex-col justify-between hover:border-tech-500/60 hover:bg-navy-800/70 transition-all cursor-pointer shadow-lg";
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-5">
                            <div class="w-11 h-11 rounded-2xl bg-navy-950 border border-slate-700/80 text-tech-400 flex items-center justify-center group-hover:scale-110 group-hover:border-tech-400 transition-all">
                                <i data-lucide="${item.icon}" class="w-5 h-5"></i>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded-lg border text-xs font-mono font-bold ${gradeBadgeColor}">
                                    Kelas ${item.grade}
                                </span>
                            </div>
                        </div>

                        <span class="text-xs font-medium text-blue-400 block mb-1.5">${item.category}</span>
                        <h3 class="text-lg font-bold text-white group-hover:text-tech-400 transition-colors leading-snug mb-3">
                            ${item.title}
                        </h3>
                        <p class="text-slate-400 text-sm leading-relaxed line-clamp-3 mb-5">
                            ${item.summary}
                        </p>
                    </div>

                    <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                        <div class="flex flex-wrap gap-1.5">
                            ${item.tools.slice(0, 2).map(tool => `<span class="text-[11px] font-mono px-2 py-0.5 rounded bg-navy-950 text-slate-300 border border-slate-800">${tool}</span>`).join("")}
                        </div>
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-tech-400 group-hover:translate-x-1 transition-transform">
                            Detail Silabus <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                        </span>
                    </div>
                `;

                card.addEventListener("click", () => openMateriModal(item));
                materiGrid.appendChild(card);
            });

            // Re-initialize Lucide icons for newly rendered elements
            lucide.createIcons();
        }

        // Open Modal with Syllabus Details
        function openMateriModal(item) {
            document.getElementById("modal-grade").textContent = `KELAS ${item.grade}`;
            document.getElementById("modal-category").textContent = item.category;
            document.getElementById("modal-title").textContent = item.title;
            document.getElementById("modal-desc").textContent = item.summary;
            document.getElementById("modal-lab").textContent = item.labProject;

            const syllabusList = document.getElementById("modal-syllabus");
            syllabusList.innerHTML = item.syllabus.map(topic => `
                <li class="flex items-start gap-3 text-sm text-slate-300 bg-navy-950/60 p-3 rounded-xl border border-slate-800/80">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-tech-400 shrink-0 mt-0.5"></i>
                    <span>${topic}</span>
                </li>
            `).join("");

            const toolsContainer = document.getElementById("modal-tools");
            toolsContainer.innerHTML = item.tools.map(tool => `
                <span class="px-2.5 py-1 rounded-lg bg-blue-500/15 text-blue-300 border border-blue-500/30 text-xs font-mono">
                    ${tool}
                </span>
            `).join("");

            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
            lucide.createIcons();
        }

        // Close Modal
        function closeMateriModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            document.body.style.overflow = "";
        }

        closeModalBtn.addEventListener("click", closeMateriModal);
        closeModalFooterBtn.addEventListener("click", closeMateriModal);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeMateriModal();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !modal.classList.contains("hidden")) {
                closeMateriModal();
            }
        });

        // Filter Event Listeners: Grade
        gradeButtons.forEach(btn => {
            btn.addEventListener("click", () => {
                gradeButtons.forEach(b => {
                    b.classList.remove("bg-tech-500", "text-navy-950");
                    b.classList.add("bg-navy-800", "text-slate-300", "border", "border-slate-700");
                });
                btn.classList.remove("bg-navy-800", "text-slate-300", "border", "border-slate-700");
                btn.classList.add("bg-tech-500", "text-navy-950");
                currentGrade = btn.dataset.grade;
                renderMateri();
            });
        });

        // Filter Event Listeners: Category
        categoryButtons.forEach(btn => {
            btn.addEventListener("click", () => {
                categoryButtons.forEach(b => {
                    b.classList.remove("bg-blue-600", "text-white");
                    b.classList.add("bg-navy-800", "text-slate-300", "border", "border-slate-700");
                });
                btn.classList.remove("bg-navy-800", "text-slate-300", "border", "border-slate-700");
                btn.classList.add("bg-blue-600", "text-white");
                currentCategory = btn.dataset.cat;
                renderMateri();
            });
        });

        // Search Input Listener
        searchInput.addEventListener("input", (e) => {
            searchQuery = e.target.value;
            renderMateri();
        });

        // Reset Filters Button
        resetFiltersBtn.addEventListener("click", () => {
            currentGrade = "ALL";
            currentCategory = "ALL";
            searchQuery = "";
            searchInput.value = "";
            gradeButtons[0].click();
            categoryButtons[0].click();
        });

        // Mobile Navigation Toggle
        const mobileMenuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        mobileMenuBtn.addEventListener("click", () => {
            mobileMenu.classList.toggle("hidden");
        });

        mobileLinks.forEach(link => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
            });
        });

        // Contact Form Submission (Custom Message Box)
        const contactForm = document.getElementById("contact-form");
        const formFeedback = document.getElementById("form-feedback");

        contactForm.addEventListener("submit", (e) => {
            e.preventDefault();
            formFeedback.classList.remove("hidden");
            contactForm.reset();
            setTimeout(() => {
                formFeedback.classList.add("hidden");
            }, 6000);
        });

        // Initial Render
        document.addEventListener("DOMContentLoaded", () => {
            renderMateri();
            lucide.createIcons();
        });
    </script>
</body>
</html>
